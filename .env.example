# ─────────────────────────────────────────────────────────────────
# HITECH — HIT Smart Academic Dashboard  |  Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env to version control.
# ─────────────────────────────────────────────────────────────────

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_REGION=ap-northeast-2

# PostgreSQL Direct Connection (Supabase)
DB_HOST=db.your-project-id.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=postgres
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# App Login Passwords
ADMIN_PASSWORD=your_admin_password_here
PROFESSOR_PASSWORD=your_faculty_password_here

# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate-a-random-secret-key-here
